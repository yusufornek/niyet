// Niyet — Tek kaynak Prisma schema
// Detaylı domain modeli: ARCHITECTURE.md §6, plan dosyası §6

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@prisma/client"
  output       = "../../graphql/src/generated/pothos-types.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enum'lar
// ─────────────────────────────────────────────────────────────

/// 15 sabit Türkçe harcama kategorisi (ADR-007).
enum SpendingCategory {
  MARKET
  FOOD_DELIVERY
  COFFEE
  DINING_OUT
  TRANSPORT
  FUEL
  BILLS
  SUBSCRIPTIONS
  ONLINE_SHOPPING
  CLOTHING
  HEALTH
  ENTERTAINMENT
  EDUCATION
  SPORTS
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLABLE
  CANCELED
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
}

enum PriceAlertDirection {
  INCREASE
  DECREASE
}

enum RuleFrequency {
  WEEKLY
  MONTHLY
  PAYDAY
  ONE_TIME
}

enum AccountType {
  CREDIT_CARD
  DEBIT
  CHECKING
  SAVINGS
}

enum CircleType {
  FAMILY
  COMMUNITY
}

enum NotificationType {
  SPENDING_ALERT
  GOAL_MILESTONE
  GOAL_PRICE_ALERT
  LEARN_UPDATE
  FINANCE_NEWS_IMPORTANT
  AI_INSIGHT
  ANALYSIS_COMPLETE
  RULE_TRIGGERED
  CONTRIBUTION_ACCEPTED
}

enum ContributionSource {
  /// Tek bir transaction'ı azaltma kararından
  REDUCIBLE_TRANSACTION
  /// Bir kategorinin tümünden ortalama farkı
  CATEGORY_BUCKET
  /// Kullanıcının serbest girdiği tutar
  MANUAL
  /// Otomatik kural tetiklemesi
  RULE_TRIGGERED
  /// İptal edilen aboneliğin yıllık tutarı katkıya dönüşür
  CANCELED_SUBSCRIPTION
}

enum ContributionStatus {
  /// Kullanıcı kabul etti, ödeme sırasını bekliyor
  PENDING
  /// Emeklilik fonuna aktarıldı (demo'da otomatik PENDING → COMMITTED)
  COMMITTED
  /// Kullanıcı geri aldı / iptal etti
  REVERSED
}

// ─────────────────────────────────────────────────────────────
// Çekirdek modeller
// ─────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  /// Supabase Auth user id (auth.users.id ile aynı). RLS policies bunu kullanır.
  authId            String?   @unique
  email             String    @unique
  name              String
  age               Int
  monthlyIncome     Decimal   @db.Money
  consentAcceptedAt DateTime?
  consentVersion    String?
  /// Maaş günü (ayın 1-31. günü). Null ise PAYDAY kuralları tetiklenmez.
  payday            Int?
  /// Nefes Ayı — bu tarihe kadar otomatik katkı kuralları atlanır.
  /// Null veya geçmiş tarih: aktif. Gelecek tarih: paused.
  pausedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts           Account[]
  bankConnections    BankConnection[]
  transactions       Transaction[]
  subscriptions      Subscription[]
  goals              Goal[]
  rules              Rule[]
  circleMemberships  CircleMembership[]
  notifications      Notification[]
  learnState         UserLearnState?
  learnProgress      UserLearnProgress[]
  futureScores       FutureScoreSnapshot[]
  badges             UserBadge[]
  analysisRuns       AnalysisRun[]
  microContributions MicroContribution[]
  chatSessions       ChatSession[]
  categoryAutoSaveRules CategoryAutoSaveRule[]
  categorySpendingAlerts CategorySpendingAlert[]
  monthlyContributionTarget MonthlyContributionTarget?

  @@index([authId])
}

/// Kullanicinin "bu ay X TL mikro katki yapmak istiyorum" hedefi. Kullanici
/// basina TEK target (1:1). Bu ay biriken katki targetAmount * warnThresholdPct
/// (default %90) noktasina ulastiginda NEAR notification; %100'e ulastiginda
/// REACHED notification (idempotency: lastAlertedMonth + lastAlertedLevel).
model MonthlyContributionTarget {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// Aylik katki hedefi (TL). > 0.
  targetAmount      Decimal  @db.Money
  /// Erken bilgilendirme esigi (0-1). Default 0.9 = %90.
  warnThresholdPct  Decimal  @default(0.9) @db.Decimal(4, 3)
  active            Boolean  @default(true)
  /// "YYYY-MM" — en son notification uretilen ay.
  lastAlertedMonth  String?
  /// "NEAR" veya "REACHED" — escalation icin.
  lastAlertedLevel  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Kullanici "azaltmak istedigim kategorilerde harcamam limite yaklasinca uyar"
/// tercihini tanimlar. Her ay maksimum 1 WARNING (>=warnThresholdPct) + 1 OVER
/// (>=%100) notification uretilir; idempotency lastAlertedMonth+lastAlertedLevel
/// ile saglanir.
model CategorySpendingAlert {
  id                 String           @id @default(cuid())
  userId             String
  category           SpendingCategory
  /// Aylik harcama limiti (TL). > 0 olmali.
  monthlyLimit       Decimal          @db.Money
  /// Erken uyari esigi (0-1). Default 0.8 = %80.
  warnThresholdPct   Decimal          @default(0.8) @db.Decimal(4, 3)
  active             Boolean          @default(true)
  /// "YYYY-MM" — en son notification uretilen ay.
  lastAlertedMonth   String?
  /// "WARNING" veya "OVER" — ayni ay icin level upgrade durumunda tekrar uretebilir.
  lastAlertedLevel   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bir kullanici ayni kategoride yalnizca bir limit tanimlayabilir.
  @@unique([userId, category])
  @@index([userId, active])
}

/// Kullanici "kahve", "yemek siparisi" gibi belirli kategoriler icin
/// "ortalama-altinda harcadigimda farki otomatik tasarrufa donustur"
/// tercihi tanimlar. Her ay maksimum 1 kez tetiklenir; idempotency
/// MicroContribution.sourceRef ile saglanir.
model CategoryAutoSaveRule {
  id             String           @id @default(cuid())
  userId         String
  category       SpendingCategory
  /// Kac aylik gecmis ortalama alinacak (default 3).
  lookbackMonths Int              @default(3)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  /// Bilgi amacli — son tetikleme zamani (denetim / debug icin).
  lastTriggeredAt DateTime?
  /// "YYYY-MM" — en son hangi ay icin tetiklendi (kullaniciya gosterim icin).
  lastTriggeredMonth String?
  /// En son tetiklemede aktarilan tutar (TL).
  lastTransferAmount Decimal?     @db.Money

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Bir kullanici ayni kategoride yalnizca bir kez tanimlayabilir.
  @@unique([userId, category])
  @@index([userId, active])
}

model BankConnection {
  id             String    @id @default(cuid())
  userId         String
  /// "Garanti BBVA", "İş Bankası", "Akbank", "Yapı Kredi", "Ziraat"
  bankName       String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  active         Boolean   @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId, active])
}

model Account {
  id         String      @id @default(cuid())
  userId     String
  bankConnId String
  type       AccountType
  /// Son 4 rakam (gerçek kart no asla saklanmaz)
  last4      String
  /// Hesap takma adı: "Maaş hesabı", "Birikim", vs.
  nickname   String?
  balance    Decimal     @db.Money

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConn     BankConnection @relation(fields: [bankConnId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String           @id @default(cuid())
  userId         String
  accountId      String
  amount         Decimal          @db.Money
  /// Merchant adı: "Starbucks", "Migros", "Netflix"
  merchant       String
  description    String?
  occurredAt     DateTime
  category       SpendingCategory
  /// Kullanıcı kategoriyi düzelttiyse true (feedback signal)
  categoryEdited Boolean          @default(false)
  /// AI abonelik tespit ettiyse
  isRecurring    Boolean          @default(false)
  /// AI azaltılabilir işaretlediyse
  isReducible    Boolean          @default(false)
  /// Tasarruf fırsatı tutarı (varsa)
  opportunity    Decimal?         @db.Money
  /// Ham banka verisi (mock için JSON)
  rawData        Json?

  /// Kullanıcı bu transaction'ın fırsatını mikro katkıya dönüştürdüyse buradadır
  acceptedContributionId String? @unique

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionAnalyses  TransactionAnalysis[]
  acceptedContribution MicroContribution?    @relation(fields: [acceptedContributionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userId, category])
  @@index([userId, isReducible])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  name            String
  amount          Decimal            @db.Money
  frequency       RuleFrequency
  status          SubscriptionStatus @default(ACTIVE)
  detectedAt      DateTime           @default(now())
  lastChargedAt   DateTime?
  /// İlişkili merchant pattern (kullanıcı 'Netflix' tx'lerini takip etmek için)
  merchantPattern String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────
// AI & Analiz
// ─────────────────────────────────────────────────────────────

model AnalysisRun {
  id                String   @id @default(cuid())
  userId            String
  triggeredAt       DateTime @default(now())
  /// "gemini-2.5-flash", "gemini-1.5-pro", ...
  geminiModel       String
  /// Full request payload (transparency için saklanır)
  request           Json
  /// Full response (tool calls dahil)
  response          Json
  durationMs        Int
  totalTransactions Int
  totalOpportunity  Decimal  @db.Money
  /// Gemini'den dönen toplam token (prompt + completion)
  totalTokens       Int?
  /// Hata varsa
  error             String?

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionAnalyses TransactionAnalysis[]

  @@index([userId, triggeredAt])
}

model TransactionAnalysis {
  id            String @id @default(cuid())
  runId         String
  transactionId String

  suggestedCategory  SpendingCategory?
  markedSubscription Boolean           @default(false)
  reducibleAmount    Decimal?          @db.Money
  /// Gemini'nin açıklaması (kullanıcıya transparency için)
  reasoning          String?

  run         AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([transactionId])
}

// ─────────────────────────────────────────────────────────────
// Hedef & Birikim
// ─────────────────────────────────────────────────────────────

model Goal {
  id                     String     @id @default(cuid())
  userId                 String
  /// "Yeni laptop", "Ev peşinatı", "Emeklilik birikimi"
  name                   String
  basePrice              Decimal    @db.Money
  currentPrice           Decimal    @db.Money
  inflationPct           Decimal    @db.Decimal(5, 2)
  targetDate             DateTime
  current                Decimal    @default(0) @db.Money
  monthlyContribution    Decimal    @db.Money
  status                 GoalStatus @default(ACTIVE)
  /// [{ date, price }] formatında price tracking
  priceHistory           Json?
  /// Goal tracking ürün sorgusunun ham hali
  rawQuery               String?
  /// Goal tracking normalize edilmiş ürün sorgusu
  normalizedQuery        String?
  category               String?
  selectedProductTitle   String?
  productUrl             String?
  productImage           String?
  productSource          String?
  currency               String     @default("TRY")
  lastCheckedAt          DateTime?
  nextPriceCheckAt       DateTime?
  priceCheckFailureCount Int        @default(0)
  priceCheckPausedUntil  DateTime?
  /// Goal Forecasting Agent (Pattern C) için context
  coachContext           String?
  planSummary            String?
  planGeneratedAt        DateTime?
  autoUpdate             Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoints        GoalCheckpoint[]
  goalPriceHistory   GoalPriceHistory[]
  goalPriceAlerts    GoalPriceAlert[]
  microContributions MicroContribution[]

  @@index([userId, status])
}

model GoalCheckpoint {
  id        String    @id @default(cuid())
  goalId    String
  /// 10, 25, 50, 75
  percent   Int
  label     String
  reached   Boolean   @default(false)
  reachedAt DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, percent])
}

model GoalPriceHistory {
  id        String   @id @default(cuid())
  goalId    String
  checkedAt DateTime @default(now())
  price     Decimal  @db.Money
  currency  String   @default("TRY")
  source    String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, checkedAt])
}

model GoalPriceAlert {
  id                    String              @id @default(cuid())
  goalId                String
  oldPrice              Decimal             @db.Money
  newPrice              Decimal             @db.Money
  percentageChange      Decimal             @db.Decimal(8, 6)
  direction             PriceAlertDirection
  remainingAmountImpact Decimal             @db.Money
  monthlySavingNeeded   Decimal             @db.Money
  readAt                DateTime?
  createdAt             DateTime            @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, readAt])
}

model Rule {
  id        String        @id @default(cuid())
  userId    String
  /// "Haftalık mikro katkı", "Maaş günü katkısı"
  label     String
  amount    Decimal       @db.Money
  frequency RuleFrequency
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  microContributions MicroContribution[]

  @@index([userId, active])
}

// ─────────────────────────────────────────────────────────────
// Sosyal (Çemberler)
// ─────────────────────────────────────────────────────────────

model Circle {
  id        String     @id @default(cuid())
  name      String
  target    Decimal    @db.Money
  type      CircleType
  /// Topluluk çemberi public mi? false ise davet ile katılım
  isPublic  Boolean    @default(false)
  /// 8 karakterli benzersiz davet kodu (alphanumeric uppercase). Paylasilarak
  /// arkadaslarin/aile uyelerini cembere davet eder.
  inviteCode String?   @unique
  createdAt DateTime   @default(now())

  members    CircleMembership[]
  milestones CircleMilestoneLog[]
}

/// Bir cemberin %25/%50/%75/%100 milestone'larina ulasildiginda buraya log
/// yazilir; ayni milestone tekrar bildirim uretmesin diye dedup kaynagi.
model CircleMilestoneLog {
  id        String   @id @default(cuid())
  circleId  String
  /// 25, 50, 75, 100
  percent   Int
  reachedAt DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([circleId, percent])
  @@index([circleId])
}

model CircleMembership {
  id           String   @id @default(cuid())
  circleId     String
  userId       String
  contribution Decimal  @default(0) @db.Money
  joinedAt     DateTime @default(now())
  /// 'admin' veya 'member'
  role         String   @default("member")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Learn (Egitim + Oyunlastirma)
// ─────────────────────────────────────────────────────────────

enum LearnSourceType {
  EGM_PAGE
  EGM_PDF
  TUIK_API
}

enum LearnPackStatus {
  DRAFT
  PUBLISHED
}

model LearnDailyPack {
  id           String         @id @default(cuid())
  packDate     DateTime       @unique
  status       LearnPackStatus @default(DRAFT)
  sourceHash   String
  summary      String
  createdAt    DateTime       @default(now())
  publishedAt  DateTime?

  cards        LearnCard[]
  facts        LearnFact[]
  snapshots    LearnSourceSnapshot[]
  progress     UserLearnProgress[]

  @@index([status, packDate])
}

model LearnSourceSnapshot {
  id            String          @id @default(cuid())
  packId         String
  sourceType     LearnSourceType
  sourceUrl      String
  sourceTitle    String
  fetchedAt      DateTime        @default(now())
  effectiveDate  DateTime?
  contentHash    String
  rawContent     String

  pack LearnDailyPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sourceType])
  @@index([sourceUrl])
}

model LearnFact {
  id            String   @id @default(cuid())
  packId         String
  key           String
  label         String
  valueText     String
  valueNumber   Decimal? @db.Decimal(12, 4)
  unit          String?
  confidence    Decimal  @db.Decimal(5, 2)
  sourceUrl     String
  effectiveDate DateTime?
  createdAt     DateTime @default(now())

  pack LearnDailyPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, key])
}

model LearnCard {
  id              String   @id @default(cuid())
  packId           String
  orderNo          Int
  slug             String
  title            String
  shortDescription String
  body             String
  sourceName       String
  sourceUrl        String
  sourceUpdatedAt  DateTime?
  createdAt        DateTime @default(now())

  pack      LearnDailyPack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  quizItems LearnQuizItem[]
  progress  UserLearnProgress[]

  @@unique([packId, orderNo])
  @@index([packId])
}

model LearnQuizItem {
  id            String   @id @default(cuid())
  cardId         String
  question       String
  optionsJson    Json
  correctIndex   Int
  explanation    String
  explanationLlm String?
  createdAt      DateTime @default(now())

  card LearnCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model FinanceNewsItem {
  id              String   @id @default(cuid())
  title           String
  summaryShort    String
  sourceName      String
  sourceUrl       String
  publishedAt     DateTime
  isImportant     Boolean  @default(false)
  importanceScore Int      @default(0)
  dedupeHash      String   @unique
  createdAt       DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
  @@index([isImportant, publishedAt(sort: Desc)])
}

model UserLearnState {
  userId          String   @id
  totalXp         Int      @default(0)
  level           Int      @default(1)
  streakDays      Int      @default(0)
  lastActiveDate  DateTime?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLearnProgress {
  id              String   @id @default(cuid())
  userId          String
  packId          String
  cardId          String
  quizScore       Int      @default(0)
  xpEarned        Int      @default(0)
  completedAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack LearnDailyPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  card LearnCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, completedAt])
}

// ─────────────────────────────────────────────────────────────
// AI Chat Sessions (Pattern B — AI Saving Coach multi-turn agent)
// ─────────────────────────────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatSession {
  id          String   @id @default(cuid())
  userId      String
  /// İlk user mesajından otomatik üretilen kısa başlık
  title       String?
  /// Hedef context (varsa) — "Bu hedef için sohbet"
  goalContext String?
  geminiModel String
  totalTokens Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        ChatRole
  /// USER: kullanıcı metni. ASSISTANT: Gemini cevabı. TOOL: function result.
  content     String
  /// Function call yapıldıysa hangi tool (set_category, recommend_subscription_to_cancel, vs.)
  toolName    String?
  /// Tool arg veya result JSON
  toolPayload Json?
  /// Bu mesaj için Gemini'nin harcadığı token sayısı (ASSISTANT için)
  tokensUsed  Int?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Mikro Emeklilik Katkıları
// ─────────────────────────────────────────────────────────────

model MicroContribution {
  id          String             @id @default(cuid())
  userId      String
  amount      Decimal            @db.Money
  /// Hangi kategoriden geldiği (analitik için; null = MANUAL)
  category    SpendingCategory?
  source      ContributionSource
  status      ContributionStatus @default(PENDING)
  /// Polymorphic kaynak: REDUCIBLE_TRANSACTION -> Transaction.id; CATEGORY_BUCKET -> category enum;
  /// RULE_TRIGGERED -> Rule.id. MANUAL'da null.
  sourceRef   String?
  /// İlişkili goal (varsa; kullanıcı katkıyı belirli hedefe yönlendirdiyse)
  goalId      String?
  /// İlişkili rule (RULE_TRIGGERED için)
  ruleId      String?
  /// Kullanıcı notu / etiket
  note        String?
  createdAt   DateTime           @default(now())
  committedAt DateTime?
  reversedAt  DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  rule        Rule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, category])
}

// ─────────────────────────────────────────────────────────────
// Engagement (Future Score & Notifications)
// ─────────────────────────────────────────────────────────────

model FutureScoreSnapshot {
  id           String   @id @default(cuid())
  userId       String
  /// 0-100 toplam skor
  score        Int
  contribution Int
  discipline   Int
  consistency  Int
  social       Int
  computedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, computedAt])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeKey   String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId, unlockedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  /// İlgili entity (transaction, goal, vs.) referansı
  payload   Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
